# Farm2Market Environment Configuration Template
# Copy this file to .env or set these environment variables in your environment.
# DO NOT commit actual secrets or credentials to source control.

# Database Configuration (PostgreSQL / Neon)
DB_URL=jdbc:postgresql://localhost:5432/farm2market
DB_USERNAME=neondb_owner
DB_PASSWORD=your_database_password_here

# Geoapify Geocoding API Key (used for location autocomplete)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Blockchain Configuration (Local Hardhat Node or RPC URL)
BLOCKCHAIN_NODE_URL=http://127.0.0.1:8545

# ML Microservice URL
ML_SERVICE_URL=http://localhost:5001
